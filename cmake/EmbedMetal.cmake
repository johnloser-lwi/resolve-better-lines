# Concatenate the Metal shader source into one C++ string, at build time.
#
#   cmake -DOUT=<file.inc> -DSRC_ROOT=<repo>/src -P EmbedMetal.cmake
#
# Metal compiles from a source string at runtime (MetalRender.mm), and a
# runtime compile has no include path -- so the includes are resolved here, by
# concatenating the files in dependency order and dropping their #include "..."
# and #pragma once lines. System includes stay: src/core guards its own
# (<cmath>, <vector>) behind !__METAL_VERSION__.
#
# Runtime rather than an offline .metallib because the offline `metal` compiler
# ships only with full Xcode, not the command line tools, and a plugin that needs
# Xcode to build is a plugin fewer people can build. Blackmagic's own Metal
# samples compile from source the same way.
#
# Each file is preceded by a #line directive, so a compile error names the real
# header and line rather than an offset into one long string.

set(FILES
    render/MetalPrelude.metal
    core/Common.h
    core/Primitives.h
    core/Style.h
    core/TileGrid.h
    core/FillGrid.h
    core/Raster.h
    render/MetalShared.h
    render/MetalKernels.metal
)

# Whole-file regex rather than file(STRINGS) + foreach: CMake lists split on
# ';', and C++ has one on nearly every line. The dropped lines are replaced by
# empty ones so the #line numbering stays true.
set(body "")
foreach(f ${FILES})
    file(READ "${SRC_ROOT}/${f}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    set(text "\n${text}")   # so the patterns can anchor on a newline, line 1 included
    string(REGEX REPLACE "\n[ \t]*#[ \t]*pragma[ \t]+once[^\n]*" "\n" text "${text}")
    string(REGEX REPLACE "\n[ \t]*#[ \t]*include[ \t]+\"[^\n]*" "\n" text "${text}")
    string(SUBSTRING "${text}" 1 -1 text)
    string(APPEND body "#line 1 \"${f}\"\n${text}\n")
endforeach()

if(body MATCHES "\\)BLMSL\"")
    message(FATAL_ERROR "Metal source contains the raw-string delimiter )BLMSL\"")
endif()

set(out "// Generated by cmake/EmbedMetal.cmake from src/core and src/render. Do not edit.\n")
string(APPEND out "static const char kBetterLineMetalSource[] = R\"BLMSL(\n${body})BLMSL\";\n")

# Only touch the file when it changed, so an unrelated rebuild does not
# recompile MetalRender.mm.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL out)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${out}")
